{
  "manifest_version": 3,
  "name": "Vintage Radio",
  "short_name": "Vintage Radio",
  "version": "1.0.0",
  "description": "Research-driven real-time vintage radio receiver and broadcast audio emulation for Chrome tabs. Local DSP, loudness-matched bypass, zero data collection.",
  "permissions": ["tabCapture", "offscreen", "activeTab", "storage"],
  "action": {
    "default_title": "Vintage Radio — Broadcast & Receiver Audio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
